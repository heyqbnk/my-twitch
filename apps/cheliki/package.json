    "browserslist-to-esbuild": "^2.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-es-x": "^10.1.0",
    "eslint-plugin-import-x": "^4.17.1",
